{
  "name": "sabatier/coredata",
  "description": "An object graph and persistence framework for PHP: managed objects, identity, faulting, change tracking and automatic schema migration.",
  "keywords": [
    "sabatier",
    "coredata",
    "mariadb",
    "persistence",
    "objectgraph"
  ],
  "homepage": "https://github.com/dantesabatier/CoreData",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "support": {
    "issues": "https://github.com/dantesabatier/CoreData/issues",
    "source": "https://github.com/dantesabatier/CoreData",
    "security": "https://github.com/dantesabatier/CoreData/security/policy"
  },
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-libxml": "*",
    "sabatier/foundation": "^1.0"
  },
  "require-dev": {
    "jetbrains/phpstorm-attributes": "^1.1",
    "phpunit/phpunit": "^13.3",
    "vimeo/psalm": "^6.17",
    "rector/rector": "^2.6"
  },
  "suggest": {
    "ext-apcu": "Required when selecting APCuRowCache for a cache shared by requests on one server.",
    "ext-redis": "Required when selecting RedisRowCache for a cache shared across servers.",
    "ext-memcached": "Required when selecting MemcachedRowCache as the shared cache backend."
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.5",
      "ext-posix": "8.5"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\CoreData\\": "src"
    },
    "files": [
      "src/CoreDataConstants.php",
      "src/CoreDataConstantsInternal.php",
      "src/MigrationOptions.php",
      "src/PersistentStoreTypes.php",
      "src/StoreOptions.php",
      "src/UserInfoKeysForStoreChangeNotifications.php",
      "src/ValidationErrorCodes.php",
      "src/VersionKeys.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\CoreData\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  }
}
