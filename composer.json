{
  "name": "sabatier/coredata",
  "description": "Core Data is an Object graph and Persistence framework that enables the organization and manipulation of data from an entity-attribute relational model.",
  "keywords": [
    "sabatier",
    "coredata",
    "persistence",
    "objectgraph"
  ],
  "homepage": "https://github.com/dantesabatier/coredata",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-dom": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-zlib": "*",
    "ext-libxml": "*",
    "sabatier/foundation": "^1.0-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpstan/phpstan": "^1.8",
    "vimeo/psalm": "^4.3",
    "squizlabs/php_codesniffer": "3.*",
    "jetbrains/phpstorm-attributes": "^1.0",
    "rector/rector": "^0.14.5"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.1",
      "ext-posix": "8.1"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\CoreData\\": "src"
    },
    "files": [
      "src/CoreDataConstants.php",
      "src/CoreDataConstantsInternal.php",
      "src/MigrationOptions.php",
      "src/PersistentStoreTypes.php",
      "src/StoreOptions.php",
      "src/UserInfoKeysForStoreChangeNotifications.php",
      "src/VersionKeys.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\CoreData\\Test\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml"
  }
}
