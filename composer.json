{
  "name": "sabatier/coredata",
  "description": "Core Data is an Object graph and Persistence framework that enables the organization and manipulation of data from an entity-attribute relational model.",
  "keywords": [
    "sabatier",
    "coredata",
    "persistence",
    "objectgraph"
  ],
  "homepage": "https://github.com/dantesabatier/coredata",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "sabatier/foundation": "@dev"
  },
  "suggest": {
    "ext-apcu": "Backs the store's L2 row cache on a single server, with no external service to run. Without one of these, the default in-memory row cache applies per process.",
    "ext-redis": "Backs the store's L2 row cache across several servers.",
    "ext-memcached": "Alternative shared backend for the store's L2 row cache."
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.5",
      "ext-posix": "8.5"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\CoreData\\": "src"
    },
    "files": [
      "src/CoreDataConstants.php",
      "src/CoreDataConstantsInternal.php",
      "src/MigrationOptions.php",
      "src/PersistentStoreTypes.php",
      "src/StoreOptions.php",
      "src/UserInfoKeysForStoreChangeNotifications.php",
      "src/ValidationErrorCodes.php",
      "src/VersionKeys.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\CoreData\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Foundation"
    }
  ]
}
