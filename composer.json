{
  "name": "sabatier/coredata",
  "description": ":package_description",
  "keywords": [
    "sabatier",
    "coredata"
  ],
  "homepage": "https://github.com/dantesabatier/coredata",
  "license": "MIT",
  "authors": [
    {
      "name": ":dantesabatier",
      "email": "dantesabatier@me.com",
      "homepage": "https://author-website.example.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "sabatier/foundation": "@dev",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-dom": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-zlib": "*",
    "ext-libxml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpstan/phpstan": "^1.8",
    "vimeo/psalm": "^4.3",
    "jetbrains/phpstorm-attributes": "^1.0"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.1",
      "ext-posix": "8.1"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\CoreData\\": "src"
    },
    "files": [
      "src/CoreDataConstants.php",
      "src/CoreDataConstantsInternal.php",
      "src/MigrationOptions.php",
      "src/PersistentStoreTypes.php",
      "src/StoreOptions.php",
      "src/UserInfoKeysForStoreChangeNotifications.php",
      "src/VersionKeys.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\CoreData\\Test\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Foundation"
    }
  ],
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml"
  },
  "optimize-autoloader": true,
  "classmap-authoritative": true
}
