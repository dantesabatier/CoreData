<?xml version="1.0"?>
<!--suppress XmlDefaultAttributeValue -->
<psalm errorLevel="3" findUnusedCode="false" findUnusedBaselineEntry="true" xmlns="https://getpsalm.org/schema/config">
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <PropertyNotSetInConstructor errorLevel="suppress"/>
        <MissingConstructor errorLevel="suppress"/>
        <RedundantPropertyInitializationCheck errorLevel="suppress"/>
        <InaccessibleProperty errorLevel="suppress"/>
        <InvalidArgument>
            <errorLevel type="suppress">
                <file name="src/EntityMigrationPolicy.php"/>
                <file name="src/FaultingSetMutationMethods.php"/>
                <file name="src/ManagedObject.php"/>
                <file name="src/ManagedObjectModel.php"/>
                <file name="src/MigrationManager.php"/>
                <file name="src/PersistentStoreCoordinator.php"/>
                <file name="src/SQLFetchRequestContext.php"/>
                <file name="src/SQLGenerator.php"/>
            </errorLevel>
        </InvalidArgument>
        <InvalidReturnType>
            <errorLevel type="suppress">
                <file name="src/PersistentStore.php"/>
            </errorLevel>
        </InvalidReturnType>
        <PossiblyNullReference>
            <errorLevel type="suppress">
                <file name="src/ManagedObjectContext.php"/>
                <file name="src/XMLObjectStore.php"/>
                <file name="src/SQLCore.php"/>
            </errorLevel>
        </PossiblyNullReference>
        <InternalClass errorLevel="suppress"/>
        <InternalProperty errorLevel="suppress"/>
        <RiskyTruthyFalsyComparison errorLevel="suppress"/>
        <ParamNameMismatch errorLevel="suppress"/>
        <DuplicateClass errorLevel="suppress"/>
        <PossiblyFalseArgument errorLevel="suppress"/>
        <FalsableReturnStatement errorLevel="suppress"/>
        <InvalidFalsableReturnType errorLevel="suppress"/>
        <UndefinedDocblockClass errorLevel="suppress"/>
        <NoInterfaceProperties errorLevel="suppress"/>
        <TypeDoesNotContainType errorLevel="suppress"/>
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <file name="src/EntityMigrationPolicy.php"/>
                <file name="src/ManagedObject.php"/>
                <file name="src/PersistentContainer.php"/>
            </errorLevel>
        </ClassMustBeFinal>
        <DocblockTypeContradiction>
            <errorLevel type="suppress">
                <file name="src/FaultingSet.php"/>
            </errorLevel>
        </DocblockTypeContradiction>
        <RedundantConditionGivenDocblockType>
            <errorLevel type="suppress">
                <file name="src/FaultingSet.php"/>
            </errorLevel>
        </RedundantConditionGivenDocblockType>
        <PossiblyInvalidArgument>
            <errorLevel type="suppress">
                <file name="src/FaultingSet.php"/>
                <file name="src/ManagedObjectContext.php"/>
                <file name="src/MemcachedRowCache.php"/>
            </errorLevel>
        </PossiblyInvalidArgument>
        <InvalidReturnType>
            <errorLevel type="suppress">
                <file name="src/FaultingSet.php"/>
                <file name="src/ManagedObjectContext.php"/>
                <file name="src/PersistentStore.php"/>
            </errorLevel>
        </InvalidReturnType>
        <InvalidReturnStatement>
            <errorLevel type="suppress">
                <file name="src/FaultingSet.php"/>
                <file name="src/ManagedObjectContext.php"/>
                <file name="src/PersistentStoreCoordinator.php"/>
            </errorLevel>
        </InvalidReturnStatement>
        <RedundantCondition>
            <errorLevel type="suppress">
                <file name="src/SQLGenerator.php"/>
            </errorLevel>
        </RedundantCondition>
        <InvalidAttribute errorLevel="suppress"/>
        <!-- A collection whose element type is decided at runtime crossing into one whose template is narrower. Six of these come from joined(), which flattens a collection of collections and so returns the element OF the element: its annotation says FlattenSequence<Element> because Psalm has no way to write Element::Element. The rest are the batch contexts, whose match answers a Number for the count and status result types and object IDs for the third, into a mixed property. -->
        <IncompatibleTypeParameters>
            <errorLevel type="suppress">
                <file name="src/BatchDeleteResult.php"/>
                <file name="src/BatchInsertResult.php"/>
                <file name="src/BatchUpdateResult.php"/>
                <file name="src/ManagedObjectContext.php"/>
                <file name="src/PersistentStoreCoordinator.php"/>
                <file name="src/SQLBatchDeleteRequestContext.php"/>
                <file name="src/SQLBatchUpdateRequestContext.php"/>
            </errorLevel>
        </IncompatibleTypeParameters>
    </issueHandlers>
    <plugins>
        <pluginClass class="Sabatier\Foundation\Plugins\Psalm\Plugin"/>
    </plugins>
</psalm>
